<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="adherent_movement_stats" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">

    <!-- Styles -->
    <style name="Title"  isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="ColumnHeader"   isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="DetailRow"  />
    <style name="AlternateRow"  backcolor="#F0F0F0"/>

    <!-- Parameters -->
    <parameter name="REPORT_DATE" class="java.util.Date" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>

    <!-- Fields -->
    <field name="adherantName" class="java.lang.String"/>
    <field name="adherantDeductible" class="java.lang.Long"/>
    <field name="totalVisits" class="java.lang.Long"/>
    <field name="totalAmount" class="java.lang.Double"/>

    <!-- Row Counter -->
    <variable name="ROW_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{adherantName}]]></variableExpression>
    </variable>

    <!-- Title -->
    <title>
        <band height="80">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="70" backcolor="#E0E0E0" forecolor="#CCCCCC"/>
            </rectangle>
            <staticText>
                <reportElement style="Title" x="20" y="20" width="495" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Adherent Movement Report]]></text>
            </staticText>
        </band>
    </title>

    <!-- Page Header -->
    <pageHeader>
        <band height="30">
            <textField pattern="MMMMM dd, yyyy">
                <reportElement x="435" y="5" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="5" width="100" height="20"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Column Headers -->
    <columnHeader>
        <band height="40">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="30" backcolor="#4F81BD" forecolor="#4F81BD"/>
            </rectangle>
            <staticText>
                <reportElement style="ColumnHeader" x="5" y="5" width="180" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="190" y="5" width="130" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Deductible]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="325" y="5" width="90" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Total Visits]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="420" y="5" width="115" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Total Amount]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Section -->
    <detail>
        <band height="40">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="20" backcolor="#F8F8F8" forecolor="#F8F8F8">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
            </rectangle>
            <!-- Name -->
            <textField textAdjust="StretchHeight">
                <reportElement style="DetailRow" x="5" y="0" width="180" height="30" stretchType="RelativeToTallestObject"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{adherantName}]]></textFieldExpression>
            </textField>

            <!-- Deductible -->
            <textField>
                <reportElement style="DetailRow" x="190" y="0" width="130" height="30" stretchType="RelativeToTallestObject"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{adherantDeductible}]]></textFieldExpression>
            </textField>

            <!-- Total Visits -->
            <textField>
                <reportElement style="DetailRow" x="325" y="0" width="90" height="30" stretchType="RelativeToTallestObject"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{totalVisits}]]></textFieldExpression>
            </textField>

            <!-- Total Amount -->
            <textField>
                <reportElement style="DetailRow" x="420" y="0" width="115" height="30" stretchType="RelativeToTallestObject"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="535" height="1"/>
            </line>
            <textField>
                <reportElement x="445" y="5" width="60" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "+ $V{PAGE_COUNT}]]></textFieldExpression>

            </textField>
        </band>
    </pageFooter>

</jasperReport>
