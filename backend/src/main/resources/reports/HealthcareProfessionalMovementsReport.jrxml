<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HealthcareProfessionalMovementsReport" pageWidth="595" pageHeight="1200" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Move the import tag to the correct position -->
    <import value="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>
    <style name="Table_Header" fontSize="12" isBold="true" pdfFontName="Helvetica-Bold" backcolor="#E0E0E0"/>
    <style name="Table_Row" fontSize="11" pdfFontName="Helvetica" backcolor="#FFFFFF"/>
    <style name="Table_Row_Alt" fontSize="11" pdfFontName="Helvetica" backcolor="#F5F5F5"/>
    <style name="Table_Alternate_Row" mode="Opaque">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style backcolor="#F8F8F8"/>
        </conditionalStyle>
    </style>

    <!-- SubDataset for the movements table -->
    <subDataset name="MovementsDataset">
        <field name="date" class="java.time.LocalDateTime"/>
        <!-- Fix LocalDateTime issue -->
        <field name="adherentName" class="java.lang.String"/>
        <field name="description" class="java.lang.String"/>
        <field name="amount" class="java.math.BigDecimal"/>
    </subDataset>

    <!-- Parameters -->
    <parameter name="healthcareProfessionalId" class="java.lang.Long"/>
    <parameter name="healthcareProfessionalName" class="java.lang.String"/>
    <parameter name="reportYear" class="java.lang.Integer"/>
    <parameter name="reportGenerationDate" class="java.util.Date"/>
    <parameter name="MonthlyTrendsChart" class="java.awt.image.BufferedImage"/>
    <parameter name="AdherentDistributionChart" class="java.awt.image.BufferedImage"/>
    <!-- Add this to your parameters section -->
    <parameter name="MovementsDataSource" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>


    <!-- Fields for the main dataset -->
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="date" class="java.time.LocalDateTime"/>
    <!-- Fix LocalDateTime issue -->
    <field name="description" class="java.lang.String"/>
    <field name="adherentName" class="java.lang.String"/>

    <!-- Variables for calculations -->
    <variable name="totalAmount" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
        <initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <variable name="averageAmount" class="java.math.BigDecimal" calculation="Average">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>

    <!-- New variable to count total movements -->
    <variable name="totalMovements" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>

    <!-- Title Section -->
    <title>
        <band height="100" splitType="Immediate">
            <textField>
                <reportElement x="0" y="10" width="555" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Healthcare Professional Movements Report"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="50" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Professional: " + $P{healthcareProfessionalName} + " (ID: " + $P{healthcareProfessionalId} + ")"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="70" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Year: " + $P{reportYear}]]></textFieldExpression>
            </textField>
            <textField pattern="MMMMM dd, yyyy">
                <reportElement x="400" y="80" width="155" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Generated on: " + new SimpleDateFormat("MMMMM dd, yyyy").format($P{reportGenerationDate})]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="98" width="555" height="1"/>
            </line>
        </band>
    </title>

    <summary>
        <band height="1050" splitType="Immediate">

            <!-- Key Statistics Section -->
            <staticText>
                <reportElement x="0" y="20" width="555" height="25"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Key Statistics]]></text>
            </staticText>
            <frame>
                <reportElement x="0" y="50" width="555" height="100"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <!-- Total Number of Movements -->
                <staticText>
                    <reportElement x="20" y="15" width="200" height="20"/>
                    <textElement>
                        <font size="12"/>
                    </textElement>
                    <text><![CDATA[Total Number of Movements:]]></text>
                </staticText>
                <textField>
                    <reportElement x="230" y="15" width="150" height="20"/>
                    <textElement textAlignment="Left">
                        <font size="12" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$V{totalMovements}]]></textFieldExpression>
                </textField>

                <!-- Total Amount -->
                <staticText>
                    <reportElement x="20" y="40" width="200" height="20"/>
                    <textElement>
                        <font size="12"/>
                    </textElement>
                    <text><![CDATA[Total Amount:]]></text>
                </staticText>
                <textField pattern="TND #,##0.00">
                    <reportElement x="230" y="40" width="150" height="20"/>
                    <textElement textAlignment="Left">
                        <font size="12" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$V{totalAmount}]]></textFieldExpression>
                </textField>

                <!-- Average Amount -->
                <staticText>
                    <reportElement x="20" y="65" width="200" height="20"/>
                    <textElement>
                        <font size="12"/>
                    </textElement>
                    <text><![CDATA[Average Movement Amount:]]></text>
                </staticText>
                <textField pattern="TND #,##0.00">
                    <reportElement x="230" y="65" width="150" height="20"/>
                    <textElement textAlignment="Left">
                        <font size="12" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$V{averageAmount}]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Monthly Trends Chart - INCREASED SIZE -->
            <staticText>
                <reportElement x="0" y="170" width="555" height="25"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Monthly Trends]]></text>
            </staticText>
            <frame>
                <reportElement x="0" y="200" width="555" height="300"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <image>
                    <reportElement x="0" y="0" width="555" height="300"/>
                    <imageExpression><![CDATA[$P{MonthlyTrendsChart}]]></imageExpression>
                </image>
            </frame>

            <!-- Adherent Distribution Chart - INCREASED SIZE -->
            <staticText>
                <reportElement x="0" y="520" width="555" height="25"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Adherent Distribution]]></text>
            </staticText>
            <frame>
                <reportElement x="0" y="550" width="555" height="300"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <image>
                    <reportElement x="0" y="0" width="555" height="300"/>
                    <imageExpression><![CDATA[$P{AdherentDistributionChart}]]></imageExpression>
                </image>
            </frame>
        </band>
    </summary>
</jasperReport>