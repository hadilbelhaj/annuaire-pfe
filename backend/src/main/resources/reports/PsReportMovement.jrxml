<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="adherent_movement_stats" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">

    <!-- Define styles for consistent formatting -->
    <style name="Title" fontName="Arial" fontSize="20" isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="ColumnHeader" fontName="Arial" fontSize="12" isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="DetailRow" fontName="Arial" fontSize="10"/>
    <style name="AlternateRow" fontName="Arial" fontSize="10" backcolor="#F0F0F0"/>

    <!-- Parameter for report date -->
    <parameter name="REPORT_DATE" class="java.util.Date" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>

    <!-- Field definitions matching your DTO -->
    <field name="adherantName" class="java.lang.String"/>
    <field name="adherantDeductible" class="java.lang.Long"/>
    <field name="adherantEmail" class="java.lang.String"/>
    <field name="totalVisits" class="java.lang.Long"/>
    <field name="totalAmount" class="java.lang.Double"/>

    <!-- Variable to count rows -->
    <variable name="ROW_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{adherantName}]]></variableExpression>
    </variable>

    <!-- Title section -->
    <title>
        <band height="80">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="70" backcolor="#E0E0E0" forecolor="#CCCCCC"/>
            </rectangle>
            <staticText>
                <reportElement style="Title" x="20" y="20" width="495" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Adherent Movement Report]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="75" width="535" height="1" forecolor="#666666"/>
                <graphicElement>
                    <pen lineWidth="2.0"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <!-- Page header -->
    <pageHeader>
        <band height="30">
            <textField pattern="MMMMM dd, yyyy">
                <reportElement x="435" y="5" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="5" width="100" height="20"/>
                <textElement/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Column header -->
    <columnHeader>
        <band height="40">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="30" backcolor="#4F81BD" forecolor="#4F81BD"/>
            </rectangle>
            <staticText>
                <reportElement style="ColumnHeader" x="5" y="5" width="150" height="20"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"/>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="155" y="5" width="80" height="20"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"/>
                <text><![CDATA[Deductible]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="235" y="5" width="150" height="20"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"/>
                <text><![CDATA[Email]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="385" y="5" width="70" height="20"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"/>
                <text><![CDATA[Total Visits]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="455" y="5" width="75" height="20"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"/>
                <text><![CDATA[Total Amount]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="35" width="535" height="1" forecolor="#666666"/>
            </line>
        </band>
    </columnHeader>

    <!-- Detail section with alternate row shading -->
    <detail>
        <band height="25">
            <!-- Alternate row background for even-numbered rows -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="20" backcolor="#F8F8F8" forecolor="#F8F8F8">
                    <printWhenExpression><![CDATA[$V{ROW_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
            </rectangle>
            <textField>
                <reportElement style="DetailRow" x="5" y="0" width="150" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{adherantName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="155" y="0" width="80" height="20"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{adherantDeductible}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="235" y="0" width="150" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{adherantEmail}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="385" y="0" width="70" height="20"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{totalVisits}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="455" y="0" width="75" height="20"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Column footer -->
    <columnFooter>
        <band height="5">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#CCCCCC"/>
            </line>
        </band>
    </columnFooter>

    <!-- Page footer -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#666666"/>
            </line>
            <staticText>
                <reportElement x="185" y="5" width="170" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Confidential - For Internal Use Only]]></text>
            </staticText>
            <textField>
                <reportElement x="445" y="5" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="505" y="5" width="30" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary section -->
    <summary>
        <band height="50">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#666666"/>
            </line>
            <textField>
                <reportElement x="5" y="10" width="200" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Adherents: " + $V{ROW_COUNT}]]></textFieldExpression>
            </textField>
            <textField pattern="EEEEE dd MMMMM yyyy">
                <reportElement x="335" y="30" width="200" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
