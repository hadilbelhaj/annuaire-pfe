<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="user_report" pageWidth="595" pageHeight="842" 
    columnWidth="535" leftMargin="30" rightMargin="30" 
    topMargin="30" bottomMargin="30">
    
    <!-- Define styles for consistent formatting -->
    <style name="Title" fontName="Arial" fontSize="20" isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="ColumnHeader" fontName="Arial" fontSize="12" isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="DetailRow" fontName="Arial" fontSize="10"/>
    <style name="AlternateRow" fontName="Arial" fontSize="10" backcolor="#F0F0F0"/>
    
    <!-- Parameters for report customization -->
    <parameter name="REPORT_DATE" class="java.util.Date" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    
    <queryString>
        <![CDATA[SELECT id, first_name, last_name, email, role, address FROM user]]>
    </queryString>
    
    <!-- Field definitions -->
    <field name="id" class="java.lang.Long"/>
    <field name="first_name" class="java.lang.String"/>
    <field name="last_name" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="role" class="java.lang.String"/>
    <field name="address" class="java.lang.String"/>
    
    <!-- Variables for calculations -->
    <variable name="ROW_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{id}]]></variableExpression>
    </variable>
    
    <!-- Title section must come first -->
    <title>
        <band height="80">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="70" backcolor="#E0E0E0" forecolor="#CCCCCC"/>
            </rectangle>
            <staticText>
                <reportElement style="Title" x="20" y="20" width="495" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[User Management Report]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="75" width="535" height="1" forecolor="#666666"/>
                <graphicElement>
                    <pen lineWidth="2.0"/>
                </graphicElement>
            </line>
        </band>
    </title>
    
    <!-- Page header band -->
    <pageHeader>
        <band height="30">
            <textField pattern="MMMMM dd, yyyy">
                <reportElement x="435" y="5" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="5" width="100" height="20"/>
                <textElement/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    
    <!-- Column headers must come before detail -->
    <columnHeader>
        <band height="40">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="30" backcolor="#4F81BD" forecolor="#4F81BD"/>
            </rectangle>
            <staticText>
                <reportElement style="ColumnHeader" x="5" y="5" width="40" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="50" y="5" width="80" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[First Name]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="135" y="5" width="80" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Last Name]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="220" y="5" width="130" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Email]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="355" y="5" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Role]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="430" y="5" width="100" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Address]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="35" width="535" height="1" forecolor="#666666"/>
            </line>
        </band>
    </columnHeader>
    
    <!-- Detail section with conditional styling -->
    <detail>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="20" backcolor="#F8F8F8" forecolor="#F8F8F8">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
            </rectangle>
            <textField>
                <reportElement style="DetailRow" x="5" y="0" width="40" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="50" y="0" width="80" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{first_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="135" y="0" width="80" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{last_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="220" y="0" width="130" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="355" y="0" width="70" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{role}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="DetailRow" x="430" y="0" width="100" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{address}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <!-- Column footer (optional) -->
    <columnFooter>
        <band height="5">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#CCCCCC"/>
            </line>
        </band>
    </columnFooter>
    
    <!-- Page footer -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#666666"/>
            </line>
            <staticText>
                <reportElement x="185" y="5" width="170" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Confidential - For Internal Use Only]]></text>
            </staticText>
            <textField>
                <reportElement x="445" y="5" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="505" y="5" width="30" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    
    <!-- Summary section must be one of the last elements -->
    <summary>
        <band height="50">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#666666"/>
            </line>
            <textField>
                <reportElement x="5" y="10" width="200" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Users: " + $V{ROW_COUNT}]]></textFieldExpression>
            </textField>
            <textField pattern="EEEEE dd MMMMM yyyy">
                <reportElement x="335" y="30" width="200" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    
</jasperReport>